opt_out_usage
default_platform(:android)

platform :android do
  desc "Deploy a new version to Google Play Store"
  lane :deploy do
    # https://docs.fastlane.tools/advanced/fastlane/#directory-behavior
    version_code = File.read("../version.properties")[/^versionCode=(\d+)/, 1]
    UI.user_error!("Could not extract versionCode") if version_code.nil?
    UI.message("Using version code #{version_code}")

    # CI builds the AAB in a separate job and downloads it into androidApp/build/outputs.
    gradle(task: "assembleRelease bundleRelease") unless ENV["SKIP_GRADLE_BUILD"]
    upload_to_play_store(
        track: 'production',
        release_status: 'completed',
        version_code: version_code.to_i,
        aab: 'androidApp/build/outputs/bundle/release/androidApp-release.aab',
        skip_upload_apk: true,
        skip_upload_metadata: true,
        skip_upload_changelogs: true,
        skip_upload_images: true,
        skip_upload_screenshots: false,
        # Skips screenshots whose SHA-256 already matches the one on Google Play.
        sync_image_upload: true,
      )
  end

  desc "Upload the store listing texts and screenshots without publishing a release"
  lane :store_listing do
    # Without a binary and a version code, supply leaves the track untouched. It
    # updates the title and descriptions of every language in metadata/android and
    # replaces the screenshots of every device type that has local images.
    upload_to_play_store(
        skip_upload_apk: true,
        skip_upload_aab: true,
        skip_upload_metadata: false,
        skip_upload_changelogs: true,
        skip_upload_images: true,
        skip_upload_screenshots: false,
        # Skips screenshots whose SHA-256 already matches the one on Google Play.
        sync_image_upload: true,
      )
  end
end
